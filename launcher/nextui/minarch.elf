#!/bin/sh
#
# Not a binary. This shadows the real minarch.elf on PATH.
#
# Emulator paks invoke `minarch.elf <core.so> <rom>` unqualified, so it is
# resolved through PATH (set in MinUI.pak/launch.sh). A launch stub prepends
# this directory, which lets us rewrite that invocation to route the core
# through the netplay shim - without modifying minarch or any system file.
#
# With no session armed we exec the real minarch with the arguments we were
# given, byte for byte, so a normal game launch is completely unaffected.

CORE="$1"
[ $# -gt 0 ] && shift

: "${SDCARD_PATH:=/mnt/SDCARD}"
: "${PLATFORM:=tg5040}"
: "${SYSTEM_PATH:=$SDCARD_PATH/.system/$PLATFORM}"

NP="$SDCARD_PATH/Tools/$PLATFORM/Netplay.pak"
SHIM="$NP/bin/$PLATFORM/netplay_shim.so"
NETPLAY_PAK="$NP"
. "$NP/launcher/state-path.sh"

# Two ways we can be reached, and they need different answers for "where is the
# real minarch":
#   - on PATH, shadowing it for one pak (launch-stub.sh)  -> system path is real
#   - bind-mounted over it, for every pak (bind-mount.sh) -> system path is US,
#     and exec'ing it would recurse forever; the real binary is at the stash
if [ -f /tmp/netplay/minarch.real ]; then
	REAL_MINARCH=/tmp/netplay/minarch.real
else
	REAL_MINARCH="$SYSTEM_PATH/bin/minarch.elf"
fi

# Anything unexpected -> behave exactly like stock.
if [ ! -x "$REAL_MINARCH" ] || [ -z "$CORE" ]; then
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

# A session is described by a file the pak app writes. Games launched from the
# game list are started by NextUI, so there is nowhere in that path for anyone
# to set an environment variable - we have to find the file ourselves and export
# it for the shim. Same reason the force flag is a file.
if [ -z "$NETPLAY_SESSION" ] && [ -f "$NETPLAY_STATE/session" ]; then
	NETPLAY_SESSION="$NETPLAY_STATE/session"
	export NETPLAY_SESSION
fi

# When the optional Game Switcher integration is enabled this shell must
# outlive MinArch. Stock MinArch attempts a quicksave before returning to the
# switcher; the shim correctly rejects that save, but MinArch has already
# written preview/slot metadata. Snapshot that small metadata set and restore
# it only when game_switcher.txt proves this was that exit path.
GS_WRAP=0
GS_META=
GS_UI_DIR=
GS_GAME_NAME=
GS_MARKER="$SDCARD_PATH/.userdata/shared/.minui/game_switcher.txt"

gameswitcher_prepare() {
	[ -n "$NETPLAY_SESSION" ] || return 0
	grep -q '^add_gameswitcher=1$' "$NETPLAY_STATE/settings" 2>/dev/null || return 0
	ROM_PATH=$1
	case "$ROM_PATH" in "$SDCARD_PATH/Roms/"*) ;; *) return 0 ;; esac

	_rel=${ROM_PATH#"$SDCARD_PATH/Roms/"}
	_folder=${_rel%%/*}
	_tag=$(printf '%s\n' "$_folder" | sed -n 's/.*(\([^()]*\))[^()]*$/\1/p')
	[ -n "$_tag" ] || return 0

	GS_GAME_NAME=$(basename "$ROM_PATH")
	_rom_dir=$(dirname "$ROM_PATH")
	_dir_name=$(basename "$_rom_dir")
	if [ -f "$_rom_dir/$_dir_name.m3u" ]; then
		GS_GAME_NAME="$_dir_name.m3u"
	fi

	GS_UI_DIR="$SDCARD_PATH/.userdata/shared/.minui/$_tag"
	GS_META="/tmp/netplay-gameswitcher-$$"
	mkdir -p "$GS_META/original"
	for _f in "$GS_UI_DIR/$GS_GAME_NAME.txt" \
	          "$GS_UI_DIR/$GS_GAME_NAME".[0-7].bmp \
	          "$GS_UI_DIR/$GS_GAME_NAME".[0-7].txt; do
		[ -f "$_f" ] && cp -p "$_f" "$GS_META/original/"
	done
	GS_WRAP=1
}

gameswitcher_cleanup() {
	[ "$GS_WRAP" = "1" ] || return 0
	if [ -f "$GS_MARKER" ]; then
		# Remove everything the failed quicksave could have created, then put
		# legitimate pre-session metadata back byte for byte.
		rm -f "$GS_UI_DIR/$GS_GAME_NAME.txt" \
		      "$GS_UI_DIR/$GS_GAME_NAME".[0-7].bmp \
		      "$GS_UI_DIR/$GS_GAME_NAME".[0-7].txt
		if [ -d "$GS_META/original" ]; then
			for _f in "$GS_META/original"/*; do
				[ -f "$_f" ] && cp -p "$_f" "$GS_UI_DIR/"
			done
		fi
		SDCARD_PATH="$SDCARD_PATH" PLATFORM="$PLATFORM" NETPLAY_PAK="$NP" \
			sh "$NP/launcher/gameswitcher.sh" active "$1" >/dev/null 2>&1
	fi
	rm -rf "$GS_META"
}

gameswitcher_prepare "$1"

# The force flag routes through the shim with no session, which is how
# passthrough gets verified on device.
if [ -z "$NETPLAY_SESSION" ] &&
   [ "$NETPLAY_FORCE_SHIM" != "1" ] &&
   [ ! -f "$NETPLAY_STATE/force-shim" ]; then
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

if [ ! -f "$SHIM" ]; then
	echo "[netplay] shim missing at $SHIM, launching stock" >&2
	exec "$REAL_MINARCH" "$CORE" "$@"
fi

. "$NP/launcher/core-route.sh"
np_route_core "$CORE"
np_stage_shim || exec "$REAL_MINARCH" "$CORE" "$@"

np_frontend() { "$REAL_MINARCH" "$SHIM_AS" "$@"; }

np_run_session "$1" "$@"
rc=$?
gameswitcher_cleanup "$1"
exit "$rc"
