-void screenshot(NDS& nds, const std::string& dir, const ds::sdl::Display::Layout& layout) {
+// The screenshot hotkey, named the way minarch names its own (Netplay.pak's
+// MinUI integration): <display name>.<YYYY-MM-DD-HH-MM-SS>.png. The display
+// name is the ROM's filename without its extension and trailing (...) or [...]
+// groups, falling back to the game code when there is no ROM.
+std::string display_name_of(NDS& nds, const std::string& rom) {
+  std::string n = rom.empty() ? std::string() : base_name(rom_stem(rom));
+  for (;;) {
+    while (!n.empty() && n.back() == ' ') n.pop_back();
+    if (n.size() < 2) break;
+    const char close = n.back();
+    const char open = close == ')' ? '(' : close == ']' ? '[' : '\0';
+    if (!open) break;
+    const size_t at = n.find_last_of(open);
+    if (at == std::string::npos) break;
+    n.resize(at);
+  }
+  while (!n.empty() && n.back() == ' ') n.pop_back();
+  if (!n.empty()) return n;
+  return std::string(nds.cart ? nds.cart->header().game_code : "NONE", 4);
+}
