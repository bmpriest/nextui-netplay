# Observe an already-running two-Brick Asphalt session without disturbing input.
# Pair with classify-asphalt-session.sh so stable visual states are compared to
# recorded baselines before resorting to manual inspection.
SESSION asphalt-observe-{date}-{time} devbridge-sessions
CONNECT_ADB 1c000c66050607724dd host
CONNECT_ADB 2c000c81b5c4078245d client
STATUS
WAIT 40000
all:SCREEN sixty-seconds
WAIT 60000
all:SCREEN two-minutes
STATUS
