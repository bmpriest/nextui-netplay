Build mGBA's lockstep SIO drivers into the libretro core. The paired (dual
instance) frontend links its two consoles through them; the libretro target
compiles the core sources only.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9d528e790..04abc2e6b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1031,6 +1031,9 @@ if(BUILD_LIBRETRO)
 	list(APPEND LIBRETRO_CORE_SRC ${VFS_SRC})
 	list(FILTER LIBRETRO_CORE_SRC EXCLUDE REGEX "/core/(scripting|library|mem-search|rewind|input)\\.c$")
 	list(FILTER LIBRETRO_CORE_SRC EXCLUDE REGEX "/util/(audio-resampler|interpolator)\\.c$")
+	# Netplay.pak: the lockstep SIO drivers, which link two consoles in one
+	# process, are left out of the libretro core list.
+	list(APPEND LIBRETRO_CORE_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/gba/sio/lockstep.c ${CMAKE_CURRENT_SOURCE_DIR}/src/gb/sio/lockstep.c)
 	if(CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY" AND NOT APPLE)
 		# Link-based function probes always succeed under static try-compile,
 		# so every find_function result above is untrustworthy; use the set
