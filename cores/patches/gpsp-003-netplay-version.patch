Mark the patched compatibility build in the public libretro version. This lets
the setup app distinguish a stock core at the same upstream revision from the
build carrying the RFU fixes required by Netplay.pak.

diff --git a/libretro/libretro.c b/libretro/libretro.c
index b822b61..58307a6 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -584,9 +584,9 @@ void retro_get_system_info(struct retro_system_info* info)
 {
    info->library_name = GPSP_NAME;
  #ifdef GIT_VERSION
-   info->library_version = GPSP_VERSION "-" GIT_VERSION;
+   info->library_version = GPSP_VERSION "-netplay-" GIT_VERSION;
  #else
-   info->library_version = GPSP_VERSION;
+   info->library_version = GPSP_VERSION "-netplay";
  #endif
    info->need_fullpath = true;
    info->block_extract = false;
