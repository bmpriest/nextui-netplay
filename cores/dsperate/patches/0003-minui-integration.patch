index 9302772..750c468 100644
--- a/src/frontend/sdl/CMakeLists.txt
+++ b/src/frontend/sdl/CMakeLists.txt
@@ -10,6 +10,13 @@ if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND
    CMAKE_CXX_COMPILER_VERSION VERSION_LESS 9)
     target_link_libraries(dsperate PRIVATE stdc++fs)
 endif()
+# MinUI/NextUI launcher integration: native power button, game-switcher
+# artifacts, the launcher-style pause menu. Vendored by
+# minui-nintendo-dsperate-pak, added here rather than to the add_executable
+# list above so the two never conflict on a rebase. minui_stb.cpp is the
+# vendored stb implementations, built without warnings: not ours to fix.
+target_sources(dsperate PRIVATE minui.cpp minui_menu.cpp minui_gfx.cpp minui_stb.cpp)
+set_source_files_properties(minui_stb.cpp PROPERTIES COMPILE_OPTIONS "-w")
 # Restamped on every build; its own translation unit so a commit recompiles nothing else.
 set(_ds_version_cpp ${CMAKE_CURRENT_BINARY_DIR}/version.cpp)
 add_custom_target(dsperate_version
