# Streets of Rage 2 - shared-screen lockstep (PicoDrive), two players.
#
# Title -> 2 PLAYERS -> each device picks its own fighter (host Max, guest
# Skate, which also proves each device drives its own player) -> 90 seconds of
# random brawling from both -> both logs must show agreement.
#
# Both devices show the same game, so the references differ only by platform.
# Run with run.sh, which fills in {host_refs}, {guest_refs} and {helpers}.
#
# Check windows are 20 s or more: checks poll (DevBridge ee0079b) and return
# at the first match, and over WiFi a lockstep stall ("Waiting for other
# player") held screens past the short windows written for three-look checks.

all:WAIT_FOR devbridge 30000
host:OPEN_GAME MD "Sega Genesis (MD)/Streets of Rage 2 (USA).zip"
WAIT 3000
guest:OPEN_GAME MD "Sega Genesis (MD)/Streets of Rage 2 (USA).zip"
all:WAIT_FOR game 30000
WAIT 12000

# Intro -> title -> mode menu -> 2 PLAYERS, in one go: the idle menu rolls
# into the attract demo sooner than both screens can be checked. Only
# Player 1 drives the menus.
# The mode menu is waited for, not timed: a session's first seconds can stall
# (4.7 s over WiFi), which puts the game behind any fixed schedule. Presses are
# held 0.3 s: one that begins and ends inside a stall (several frames over
# WiFi) is never sampled by the game.
host:TRM sh {helpers}/keys.sh start:0.3:2.5 start:0.3:0
host:VERIFY_WAIT {host_refs}/sor2-menu.png 20000
host:TRM sh {helpers}/keys.sh down:0.3:0.8 start:0.3:3
host:VERIFY_WAIT {host_refs}/sor2-select.png 20000
guest:VERIFY_WAIT {guest_refs}/sor2-select.png 20000

# Host moves to Max, guest to Skate. The portraits flash, so a match scores up
# to ~8 while the unmoved screen is only 12.5 away on the Brick: keep the
# default threshold of 10 here.
host:TRM sh {helpers}/keys.sh --bg left:0.3:0
guest:TRM sh {helpers}/keys.sh --bg right:0.3:0
WAIT 1500
host:VERIFY_WAIT {host_refs}/sor2-max-skate.png 20000
guest:VERIFY_WAIT {guest_refs}/sor2-max-skate.png 20000

# Both confirm, then fight.
host:TRM sh {helpers}/keys.sh --bg start:0.3:0
guest:TRM sh {helpers}/keys.sh --bg start:0.3:0
WAIT 6000
host:TRM sh {helpers}/gameplay.sh --bg 90 right right right+a right+b left a a b b x right+x up down up+right down+right a+b
guest:TRM sh {helpers}/gameplay.sh --bg 90 right right right+a right+b left a a b b x right+x up down up+right down+right a+b
# Nothing but the game on the link while it plays: captures over a shared
# radio show up as stalls.
WAIT 93000
all:SCREEN sor2-after-play

host:TRM sh {helpers}/check.sh shared Streets_of_Rage_2 50
guest:TRM sh {helpers}/check.sh shared Streets_of_Rage_2 50

# quit.sh: MinArch's own menu, then SIGTERM, then SIGKILL (QUIT_GAME's remote
# presses stretched through a tunnel and left a Brick in the game).
all:TRM sh {helpers}/quit.sh minarch
all:WAIT_FOR devbridge 30000
