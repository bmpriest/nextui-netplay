# Super Mario Bros. Deluxe - Game Boy Color link (Gambatte), VS mode.
#
# Past the title and file screens on both, VS on the main menu, then 90
# seconds of random running and jumping -> both logs must show the link.
#
# Built from the 2026-11-05 protocol comparison on spruce (Brick hosting the
# RG35XXH), where paired consoles (`ctl.sh set instanced 1` on both before
# arming) passed with every checkpoint agreeing. Gambatte's plain link cable
# did not: VS came up on one side only. No references recorded yet, so the
# screens are captures to look at, not checks.

all:WAIT_FOR devbridge 30000
host:OPEN_GAME GBC "Game Boy Color (GBC)/Super Mario Bros. Deluxe (USA, Europe) (Rev 2).zip"
WAIT 3000
guest:OPEN_GAME GBC "Game Boy Color (GBC)/Super Mario Bros. Deluxe (USA, Europe) (Rev 2).zip"
all:WAIT_FOR game 30000
WAIT 15000

# Each device on its own console, pressed together: A past the title, A past
# the file screen, then DOWN DOWN A to VS.
host:TRM sh {helpers}/keys.sh --bg a:0.3:2.5
guest:TRM sh {helpers}/keys.sh --bg a:0.3:2.5
WAIT 3500
all:SCREEN mariodx-1
host:TRM sh {helpers}/keys.sh --bg a:0.35:3
guest:TRM sh {helpers}/keys.sh --bg a:0.35:3
WAIT 4000
all:SCREEN mariodx-2
host:TRM sh {helpers}/keys.sh --bg down:0.25:0.7 down:0.25:0.7 a:0.35:0
guest:TRM sh {helpers}/keys.sh --bg down:0.25:0.7 down:0.25:0.7 a:0.35:0
WAIT 6000
all:SCREEN mariodx-vs

host:TRM sh {helpers}/gameplay.sh --bg 90 right right right+a right+b right+a+b left a b right
guest:TRM sh {helpers}/gameplay.sh --bg 90 right right right+a right+b right+a+b left a b right
WAIT 93000
all:SCREEN mariodx-after-play

host:TRM sh {helpers}/check.sh instanced Deluxe 45
guest:TRM sh {helpers}/check.sh instanced Deluxe 45

all:TRM sh {helpers}/quit.sh minarch
all:WAIT_FOR devbridge 30000
